# ============================================================
# BAOCHAT - cấu hình môi trường. Copy thành .env.local rồi điền.
# KHÔNG commit file .env.local. Tất cả khóa bí mật chỉ nằm ở server.
# ============================================================

# --- Ứng dụng ---
# URL công khai của website (không có dấu / ở cuối). Dùng cho OAuth và link email.
APP_URL=http://localhost:3000

# --- Database (PostgreSQL / Supabase / Neon) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/baochat
# Đặt true nếu nhà cung cấp DB yêu cầu SSL (Supabase, Neon, Railway...)
DATABASE_SSL=false

# --- Google OAuth (BẮT BUỘC cho đăng nhập Google và tài khoản admin) ---
# Tạo tại https://console.cloud.google.com/apis/credentials  (OAuth client, loại Web application)
# Authorized redirect URI:  ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tài khoản quản trị ---
# Danh sách email (cách nhau bằng dấu phẩy). Chỉ được cấp quyền admin khi
# đăng nhập bằng Google và Google xác nhận email_verified = true.
ADMIN_EMAILS=tomfro2016@gmail.com

# --- Email (SMTP) - cho xác minh email & quên mật khẩu ---
# Nếu để trống: không gửi được email; hệ thống tự động BỎ yêu cầu xác minh email
# (link vẫn được in ra log server ở môi trường dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Baochat <no-reply@example.com>"

# --- AI providers (chỉ cần điền provider bạn muốn dùng) ---
# Khóa chỉ được đọc từ biến môi trường, không lưu trong database, không gửi xuống trình duyệt.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# (Tuỳ chọn) Model giọng đọc Gemini, mặc định gemini-2.5-flash-preview-tts
GEMINI_TTS_MODEL=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# --- Tìm kiếm Internet (chọn 1 trong 2; Tavily được ưu tiên nếu có cả hai) ---
TAVILY_API_KEY=
BRAVE_API_KEY=

# Templated.io (PDF slide thiết kế và ảnh bìa). Tên lớp trong mẫu: slide = title, body, page; bìa = title, subtitle
TEMPLATED_API_KEY=
TEMPLATED_SLIDE_TEMPLATE=
TEMPLATED_COVER_TEMPLATE=

# --- Khác ---
# Số proxy tin cậy phía trước app (Vercel/Cloudflare = 1) để lấy IP thật cho rate limit.
TRUST_PROXY=1
